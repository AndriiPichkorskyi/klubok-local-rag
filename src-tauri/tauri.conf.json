{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klubok",
  "version": "0.1.0",
  "identifier": "com.andriipichkorskiy.local-tool-rag-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Klubok",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Klubok",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../sidecar/src": "sidecar/src",
      "../sidecar/node_modules": "sidecar/node_modules",
      "../sidecar/package.json": "sidecar/package.json",
      "../config": "config"
    }
  }
}
