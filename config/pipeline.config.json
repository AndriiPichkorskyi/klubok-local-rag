{
  "_опис": "Єдиний конфіг усього проєкта. Читається sidecar/src/config/config.js та Rust-частиною. Змінюйте тут, а не в коді.",
  "embedModelName": "qwen3-embedding:0.6b",
  "_embedModelName_варіанти": [
    "qwen3-embedding:0.6b",
    "qwen3-embedding:4b"
  ],
  "rpc": {
    "host": "127.0.0.1",
    "port": 17817,
    "token": "dev-local-token-change-me",
    "_коментар": "WebSocket-канал між Tauri та sidecar. Слухає лише localhost.",
    "requestTimeoutSec": 7200,
    "_requestTimeoutSec_коментар": "Ліміт очікування однієї відповіді. Повна векторизація може тривати години."
  },
  "ollama": {
    "baseUrl": "http://localhost:11434",
    "chatModel": "qwen3:1.7b",
    "visionModel": "qwen2.5vl:3b",
    "_visionModel_коментар": "Використовується модулем walkthrough для аналізу скріншотів"
  },
  "scraper": {
    "timeoutMs": 30000,
    "delayMs": 200
  },
  "indexer": {
    "chunkSize": 500,
    "chunkOverlap": 50,
    "concurrency": 2,
    "keywordConcurrency": 2,
    "enableKeywordAugmentation": true,
    "scanLocalDocs": true,
    "maxLocalDocsPerApp": 100
  },
  "rag": {
    "topK": 15,
    "searchMode": "hybrid",
    "_searchMode_варіанти": [
      "vector",
      "fts",
      "hybrid"
    ],
    "enableXmlTags": true,
    "enableContextReordering": true,
    "enableJsonFormat": true,
    "testConcurrency": 3,
    "excludeLocalDocs": false
  },
  "bootstrap": {
    "requiredModels": [
      "qwen3:1.7b",
      "qwen3-embedding:0.6b"
    ],
    "optionalModels": [
      "qwen3-embedding:4b",
      "qwen2.5vl:3b"
    ],
    "autoPull": false,
    "_autoPull_коментар": "true = завантажувати відсутні моделі автоматично при першому запуску"
  },
  "walkthrough": {
    "enableScreenAnalysis": true,
    "captureMode": "window",
    "_captureMode_варіанти": [
      "window",
      "fullscreen"
    ],
    "screenshotDir": "./sidecar/data/screenshots",
    "maxStepsPerSession": 12
  }
}
