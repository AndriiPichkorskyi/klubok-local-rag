/**
 * Файл: src/config/config.js
 * Опис: Головний конфігураційний файл проєкту. Зберігає налаштування для бази даних,
 *       Ollama (LLM), веб-скрапера та параметри векторного пошуку RAG.
 */

import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT_DIR = path.resolve(__dirname, "../../");

const EMBED_MODEL = process.env.EMBED_MODEL || "qwen3-embedding:0.6b"; // "qwen3-embedding:0.6b", "qwen3-embedding:4b"

export const config = {
  embedModelName: EMBED_MODEL,
  db: {
    sqlitePath: path.join(ROOT_DIR, "rag_metadata.sqlite"),
    lancedbPath: path.join(ROOT_DIR, `lancedb_data_${EMBED_MODEL.replace(":", "_")}`),
  },
  ollama: {
    baseUrl: "http://localhost:11434",
    chatModel: "qwen3:1.7b", // Модель для генерації відповідей
    embedModel: EMBED_MODEL, // Динамічна модель (вибирається зверху файлу)
  },
  scraper: {
    timeoutMs: 30000, // Таймаут для завантаження веб-сторінок
    delayMs: 200, // Затримка між запитами (Rate limit prevention)
  },
  indexer: {
    chunkSize: 500,
    chunkOverlap: 50,
    concurrency: 2, // Для векторизації (Embeddings дуже швидкі, можна 8)
    keywordConcurrency: 2, // 1 потік, щоб не "вішати" Ollama
    enableKeywordAugmentation: true,
    scanLocalDocs: true,
    maxLocalDocsPerApp: 100, // Обмеження на кількість локальних HTML файлів для однієї програми
  },
  rag: {
    topK: 15,
    searchMode: "hybrid",
    enableXmlTags: true,
    enableContextReordering: true,
    enableJsonFormat: true, // Перемикач для JSON формату LLM
    testConcurrency: 3, // Кількість паралельних потоків для прогону тестів
    excludeLocalDocs: false, // Чи виключати локальну довідку під час пошуку
  },
};
